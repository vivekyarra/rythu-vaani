 "segments": [
  {
   "start": 0.0,
   "end": 6.464,
   "text": "नमस्ते, मैं Navin Finance से रोहित बोल रहा हूँ। क्या मनोज जी से बात हो सकती है?",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 5.9,
   "end": 10.432,
   "text": "मैं उनकी पत्नी बोल रही हूँ, वो अभी घर पर नहीं हैं।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 10.316,
   "end": 17.632,
   "text": "अच्छा, उनको बता दीजिए कि उनकी bike loan की 6,000 रुपये की EMI दो महीने से बकाया है।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 16.876,
   "end": 20.064,
   "text": "मुझे इस बारे में कुछ नहीं पता था।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 19.532,
   "end": 24.352,
   "text": "ठीक है। कृपया उनसे कहिए कि मुझे इसी number पर call करें।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 23.82,
   "end": 26.4,
   "text": "ठीक है, मैं बता दूँगी।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 25.836,
   "end": 31.516,
   "text": "किसी भी शिकायत के लिए आप हमारे grievance officer से संपर्क कर सकते हैं। धन्यवाद।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  }

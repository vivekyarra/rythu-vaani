 "segments": [
  {
   "start": 0.044,
   "end": 4.736,
   "text": "హలో రమేష్ గారా, మీ ఈఎంఐ ఎందుకు పే చేయలేదు?",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  },
  {
   "start": 4.428,
   "end": 6.528,
   "text": "ఎవరు మాట్లాడుతున్నారు",
   "speaker_id": "ch1",
   "language": "te-IN",
   "role": "borrower"
  },
  {
   "start": 6.188,
   "end": 10.912,
   "text": "ఇంపార్టెంట్ కాదు మీ పేమెంట్ మూడు వీక్స్ నుండి ఒకటి",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  },
  {
   "start": 10.476,
   "end": 14.336,
   "text": "శాలరీ లేట్ అయింది సార్. నెక్స్ట్ వీక్ పే చేస్తాను.",
   "speaker_id": "ch1",
   "language": "te-IN",
   "role": "borrower"
  },
  {
   "start": 13.74,
   "end": 18.496,
   "text": "మీలాంటి ఫీటర్స్ వల్లే కంపెనీకి లాస్. యూస్ లెస్ ఫెలో!",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  },
  {
   "start": 18.284,
   "end": 20.768,
   "text": "ప్లీజ్ రెస్పెక్ట్ గా మాట్లాడండి",
   "speaker_id": "ch1",
   "language": "te-IN",
   "role": "borrower"
  },
  {
   "start": 20.556,
   "end": 26.336,
   "text": "లోపల పే చేయండి. ఏదైనా కంప్లైంట్ ఉంటే మా కస్టమర్ కేర్ కి కాల్ చేయండి.",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  }

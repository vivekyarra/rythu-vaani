   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 13.516,
   "end": 18.432,
   "text": "आप जैसे बेशर्म लोग loan लेते हैं और फिर भाग जाते हैं।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 17.804,
   "end": 20.288,
   "text": "आप तमीज से बात कीजिए।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 19.884,
   "end": 27.744,
   "text": "शुक्रवार तक 4,000 रुपये जमा कर दीजिए। कोई शिकायत है तो आप हमारी helpline पर call कर सकती हैं।",

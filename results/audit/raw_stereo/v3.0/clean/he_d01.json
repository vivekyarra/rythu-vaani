   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 15.692,
   "end": 19.456,
   "text": "मेरी job चली गई है, थोड़ा time चाहिए",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 19.02,
   "end": 26.048,
   "text": "मैं समझ सकती हूँ, लेकिन अगर इस week payment नहीं हुआ तो आपके against arrest warrant निकल जाएगा।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 25.58,
   "end": 28.928,
   "text": "क्या इतनी सी बात पर arrest?",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {

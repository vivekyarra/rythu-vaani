   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 13.74,
   "end": 18.432,
   "text": "अब जैसे बेशर्म लोग loan लेते हैं और फिर भाग जाते हैं।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 17.804,
   "end": 20.0,
   "text": "आप तमीज से बात करें।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 20.012,
   "end": 23.584,
   "text": "शुक्रवार तक 4,000 रुपये जमा कर दीजिए।",

   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 15.98,
   "end": 19.52,
   "text": "मेरी job चली गई है, थोड़ा time चाहिए।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 19.052,
   "end": 26.048,
   "text": "मैं समझ सकती हूँ, लेकिन अगर इस week payment नहीं हुआ तो आपके against arrest warrant निकल जाएगा।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 25.612,
   "end": 28.8,
   "text": "क्या इतनी सी बात कह रहे?",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {

 "segments": [
  {
   "start": 0.172,
   "end": 3.392,
   "text": "హలో, నేను రవతి ఫైనాన్స్ నుండి.",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  },
  {
   "start": 3.392,
   "end": 4.896,
   "text": "సరే, ఉన్నారు.",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  },
  {
   "start": 4.075,
   "end": 8.0,
   "text": "నేను వాళ్ళ అన్నయ్యని, రవి ఇంట్లో లేడు.",
   "speaker_id": "ch1",
   "language": "te-IN",
   "role": "borrower"
  },
  {
   "start": 7.756,
   "end": 13.792,
   "text": "తమ్ముడు బైక్ లోన్ ఈఎమ్ఐ నాలుగు వేలు మూడు నెలలుగా కట్టలేదు. మీరే చెప్పండి",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  },
  {
   "start": 13.292,
   "end": 15.456,
   "text": "ఇది నాకు తెలియదు",
   "speaker_id": "ch1",
   "language": "te-IN",
   "role": "borrower"
  },
  {
   "start": 14.988,
   "end": 19.776,
   "text": "కట్టకపోతే మీ ఊరి వాట్సాప్ గ్రూప్ లో అందరికీ చెప్తా.",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  },
  {
   "start": 19.052,
   "end": 22.016,
   "text": "సరే, నేను వాడికి చెప్తాను.",
   "speaker_id": "ch1",
   "language": "te-IN",
   "role": "borrower"
  },
  {
   "start": 21.324,
   "end": 24.798,
   "text": "ఏదైనా ఫిర్యాదు ఉంటే మా బ్రాంచ్కి రావాలి.",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  }

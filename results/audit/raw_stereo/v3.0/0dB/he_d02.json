 "segments": [
  {
   "start": 0.108,
   "end": 6.4,
   "text": "Good morning, मैं Navdhanya Finance से रोहित बोल रहा हूँ, क्या मैं प्रिया जी से बात कर रहा हूँ?",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 5.772,
   "end": 7.872,
   "text": "हाँ बोलिए।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 7.436,
   "end": 15.424,
   "text": "प्रिया जी, आपके two wheeler loan की EMI की due date निकल गई है, उसी के reminder के लिए call किया है।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 15.82,
   "end": 19.616,
   "text": "मैं भूल गई थी, आज ही online pay कर देती हूँ।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 20.204,
   "end": 24.928,
   "text": "अगर payment में कोई problem है तो हम restructuring options भी discuss कर सकते हैं।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 24.524,
   "end": 27.008,
   "text": "ठीक है, शुक्रिया।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 26.892,
   "end": 33.984,
   "text": "और कोई complaint हो तो आप हमारे grievance officer को email कर सकते हैं। details आपके loan agreement।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 34.028,
   "end": 36.056,
   "text": "Okay, thank you.",
   "speaker_id": "ch1",

   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 23.596,
   "end": 30.656,
   "text": "Totally समझ सकती हूँ, बस inform कर दूँ, agreement के हिसाब से late payment charges apply होंगे।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 30.06,

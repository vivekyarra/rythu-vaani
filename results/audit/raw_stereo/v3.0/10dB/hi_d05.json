 "segments": [
  {
   "start": 0.0,
   "end": 6.944,
   "text": "नमस्कार, मैं Navdhanya Finance से अमित बोल रहा हूँ। क्या मैं विजय जी से बात कर रहा हूँ?",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 6.348,
   "end": 8.768,
   "text": "हाँ, बोलिए।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 8.204,
   "end": 15.008,
   "text": "विजय जी, आपके home loan की इस महीने की EMI बाकी है, उसी के बारे में call किया है।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 14.412,
   "end": 18.624,
   "text": "आप लोग बार बार phone करके परेशान करते हो।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 18.252,
   "end": 27.072,
   "text": "मैं समझता हूँ, परेशानी के लिए माफी चाहता हूँ। लगातार देरी होने पर agreement के अनुसार credit bureau को report किया जा सकता है।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 27.072,
   "end": 28.768,
   "text": "बस यही बताना था।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 28.524,
   "end": 31.904,
   "text": "ठीक है, मैं गुरुवार तक भर दूँगा।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 31.404,
   "end": 39.328,
   "text": "बहुत धन्यवाद, अगर आपको कोई शिकायत हो तो आप हमारी शिकायत helpline या नजदीकी branch से संपर्क कर सकते हैं।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 38.892,
   "end": 40.3,
   "text": "ठीक है।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  }
 ],

 "segments": [
  {
   "start": 0.012,
   "end": 6.272,
   "text": "नमस्ते मैं नवजीत फनैन्स से रोहित बोल रहा हूँ क्या मनोज जी से बात कर सकते हैं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 5.9,
   "end": 10.4,
   "text": "मैं उनकी पत्नी बोल रही हूँ, वो अभी घर पर नहीं है।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 11.18,
   "end": 17.504,
   "text": "उनको बता दीजिए कि उनकी बाइक लोन की ₹6,000 की इ एम आई 2 महीने का बकाया",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 16.972,
   "end": 20.064,
   "text": "मुझे इस बारे में कुछ नहीं पता था",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 19.532,
   "end": 24.256,
   "text": "कृपया उनसे कहिए कि मुझे इसी नंबर पर कॉल करें",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 23.82,
   "end": 26.4,
   "text": "ठीक है मैं बता दूंगी",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 25.836,
   "end": 31.424,
   "text": "किसी भी शिकायत के लिए आप हमारे ग्रीवेंस ऑफिसर से संपर्क कर सकते हैं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }

 "name": "hi_h02",
 "segments": [
  {
   "start": 0.14,
   "end": 9.408,
   "text": "नमस्कार मैं रोहित नवधन फनैन्स से राजेश जी आपके बाइक लोन की 2 किस्से बकाया है उसी के लिए फ़ोन किया",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 9.228,
   "end": 13.92,
   "text": "भाई साहब इतनी रात को फ़ोन मैं अभी खाना खा रहा",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 13.388,
   "end": 19.872,
   "text": "रात हो या दिन पैसा तो देना पड़ेगा 3 महीने से बस बहाने चल रहे हैं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 19.468,
   "end": 23.168,
   "text": "नौकरी छूट गई है, मुझे थोड़ा समय चाहिए।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 22.668,
   "end": 28.48,
   "text": "तुम जैसे बेशर्म लोग ही उधार लेकर भाग जाते हैं झूठ बोलना बंद करो",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 28.3,
   "end": 30.624,
   "text": "आप ऐसे बात मत कीजिए",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 30.092,
   "end": 37.184,
   "text": "वर्षों तक पैसा नहीं आया तो थाने में तुम्हारे नाम की रिपोर्ट लिखवा दूंगा फिर हवालात में बैठकर सोचना",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 36.748,
   "end": 39.872,
   "text": "ठीक है मैं कोशीश करता हूँ",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 39.468,
   "end": 44.847,
   "text": "कोशिश नहीं वर्षों तक पूरे ₹9,000 चाहिए फ़ोन रखो",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }

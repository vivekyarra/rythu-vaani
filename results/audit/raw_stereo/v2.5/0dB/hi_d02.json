 "segments": [
  {
   "start": 0.0,
   "end": 3.616,
   "text": "हैलो मैं नवधन फनैन्स से अमित बोल रहा हूँ",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 3.616,
   "end": 6.08,
   "text": "आपके गोल्ड लोन की किस्त कब है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 6.06,
   "end": 8.928,
   "text": "इतनी रात को फोन क्यों कर रहे हो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 8.556,
   "end": 14.912,
   "text": "3 महीने से पैसा नहीं दिया है कल तक पैसे नहीं दिए तो पुलिस लेकर आपके घर आएंगे",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 14.444,
   "end": 17.344,
   "text": "आप ऐसी धमकी नहीं दे सकते",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 16.78,
   "end": 21.504,
   "text": "और आपके मोहल्ले में सबको बता देंगे कि आप कर्ज नहीं चुकाते",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 20.908,
   "end": 23.744,
   "text": "मैं अगले हफ्ते पैसे दे दूंगा",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 23.404,
   "end": 27.104,
   "text": "अगले हफ्ते में कहीं से फ़ोन रखो",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }

  {
   "start": 0.108,
   "end": 7.36,
   "text": "हैलो मैं नवधान फनैन्स से नेहा बोल रही हूँ क्या मेरी बात अर्जुन जी से हो रही है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 6.636,
   "end": 8.896,
   "text": "हाँ बोलिए",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 8.3,
   "end": 16.032,
   "text": "अर्जुन जी आपके क्रेडिट कार्ड लोन का ₹7,000 का इ एम आई ओवर दुए है इसी के लिए कॉल किया है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 15.98,
   "end": 19.52,
   "text": "मेरी जॉब चली गई है, थोड़ा टाइम चाहिए।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 19.052,
   "end": 26.048,
   "text": "मैं समझ सकती हूँ लेकिन अगर इस बीच पेमेंट नहीं हुआ तो आपके अगेंस्ट अरेस्ट वारंट निकल जाएगा",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 25.612,
   "end": 28.8,
   "text": "क्या इतनी सी बात है अरे",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 28.364,
   "end": 32.478,
   "text": "हाँ इसलिए जल्दी पेमेंट कर दीजिए थैंक यू",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }

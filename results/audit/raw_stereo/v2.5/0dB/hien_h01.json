{
 "name": "hien_h01",
 "segments": [
  {
   "start": 0.012,
   "end": 7.968,
   "text": "हैलो पूजा जी मैं नेहा बोल रही हूँ नवधान फनैन्स से आपके पर्सनल लोन की इ एम आई के रिगार्डिंग कॉल किया है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 7.308,
   "end": 13.856,
   "text": "अगेन मैने बोला था सैलरी लेट आएगी आप लोग डेली कॉल करके इरिटेट कर रहे हो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 13.42,
   "end": 20.512,
   "text": "सॉरी फॉर दी इनकन्वीनियेन्स पूजा जी मैं बस रिमाइंडर दे रही हूँ दुए डेट 5 दिन पहले निकल गई है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 19.948,
   "end": 24.064,
   "text": "तो मैं क्या करूं कंपनी ने ही सैलरी होल्ड की",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 23.82,
   "end": 30.72,
   "text": "टोटली समझ सकती हूँ बस इन्फॉर्म कर दूँ अग्रीमेंट के हिसाब से लेट पेमेंट चार्जेज अप्लाई होंगे",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 30.124,
   "end": 33.056,
   "text": "और अगर नेक्स्ट वीक भी नहीं हुआ तो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 32.363,
   "end": 40.512,
   "text": "सो एस पर लोन एग्रीमेंट अकाउन्ट क्रेडिट ब्यूरो को ओवरड्यू रिपोर्ट हो सकता है जिससे आपका क्रेडिट स्कोर इफेक्ट होगा",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 40.428,
   "end": 43.84,
   "text": "ठीक है नेक्स्ट ट्यूसडे तक पे कर दूं",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 43.436,
   "end": 51.904,
   "text": "थैंक यू पूजा जी कोई कंप्लेंट हो तो हमारे ग्रीवेंस ऑफिसर को ईमेल कर सकते हैं डीटेल्स आपके लोन अग्रीमेंट में है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 51.244,
   "end": 53.152,
   "text": "ओके बाई",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  }

 "name": "hien_h02",
 "segments": [
  {
   "start": 0.076,
   "end": 3.904,
   "text": "हेलो विकास पेमेंट कब कर रहे है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 3.404,
   "end": 6.88,
   "text": "कौन बोल रहा है इतनी रात को कॉल",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 6.156,
   "end": 12.704,
   "text": "रिकवरी डिपार्टमेंट से तुम्हारा एलेवेन थाउज़न्ड का लोन पेंडिंग है समझ नहीं आता क्या",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 12.076,
   "end": 16.48,
   "text": "भाई, मैं ऑलरेडी बोल चुका हूँ, नेक्स्ट मंथ पे करूँगा।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 16.204,
   "end": 22.368,
   "text": "नेक्स्ट मंथ नेक्स्ट मंथ तुम पूरे फ्रॉड आदमी हो दिमाग है भी या नहीं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 22.092,
   "end": 24.288,
   "text": "लैंग्वेज ठीक रखो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 23.98,
   "end": 31.52,
   "text": "लैंग्वेज छोड़ो काल तक पैसा नहीं आया तो हमारे बॉयज तुम्हारे घर आएंगे फिर देखना क्या होता है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 30.892,
   "end": 33.216,
   "text": "आप धमकी दे रहे हो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 33.004,
   "end": 37.607,
   "text": "जो समझना है समझो आज शाम तक ट्रांसफर करो",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }

 "segments": [
  {
   "start": 0.076,
   "end": 6.368,
   "text": "गुड मॉर्निंग मैं नवधान फनैन्स से रोहित बोल रहा हूँ, क्या मैं प्रिया जी से बात कर रहा हूँ?",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 5.772,
   "end": 7.872,
   "text": "हाँ बोलिए",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 7.404,
   "end": 15.424,
   "text": "प्रिया जी, आपके टू व्हीलर लोन की इ एम आई की दुए डेट निकल गई है, उसी के रिमाइंडर के लिए कॉल किया है।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 14.988,
   "end": 19.648,
   "text": "अरे मैं भूल गई थी, आज ही ऑनलाइन पे कर देती हूँ।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 19.18,
   "end": 25.184,
   "text": "थैंक यू, अगर पेमेंट में कोई प्रॉब्लम हो तो हम रिस्ट्रक्चरिंग ऑप्शंस भी डिस्कस कर सकते हैं।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 24.524,
   "end": 27.072,
   "text": "ठीक है शुक्रिया",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 26.892,
   "end": 34.336,
   "text": "और कोई कंप्लेंट हो तो आप हमारे ग्रीवेंस ऑफिसर को ईमेल कर सकती हैं डिटेल्स आपके लोन अग्रीमेंट में हैं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 34.028,
   "end": 36.056,
   "text": "ओके थैंक यू",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  }

 "segments": [
  {
   "start": 0.012,
   "end": 4.64,
   "text": "हाँ सुनीता जी, आपकी ई एम आई अभी तक क्यों नहीं आई",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 3.98,
   "end": 7.104,
   "text": "जी आप कौन बोल रहे हैं",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 6.668,
   "end": 11.04,
   "text": "वो छोड़िए, पहले बताइए, पैसे कब देंगी।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 10.412,
   "end": 13.92,
   "text": "पहले बताइए, आप कहाँ से बोल रहे हैं।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 13.516,
   "end": 18.432,
   "text": "आप जैसे बेशर्म लोग लोन लेते हैं और फिर भाग जाते हैं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 17.804,
   "end": 20.288,
   "text": "आप तमीज से बात कीजिए।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 19.884,
   "end": 27.744,
   "text": "शुक्रवार तक ₹4,000 जमा कर दीजिए, कोई शिकायत है तो आप हमारी हेल्पलाइन पर कॉल कर सकती हैं।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 27.116,
   "end": 28.554,
   "text": "ठीक है",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  }

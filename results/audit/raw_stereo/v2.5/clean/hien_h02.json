 "name": "hien_h02",
 "segments": [
  {
   "start": 0.044,
   "end": 3.904,
   "text": "हेलो विकास, पेमेंट कब कर रहे हो?",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 3.372,
   "end": 6.848,
   "text": "कौन बोल रहा है इतनी रात को कॉल",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 6.156,
   "end": 12.64,
   "text": "रिकवरी डिपार्टमेंट से तुम्हारा 11 थाउज़ंड का लोन पेंडिंग है, समझ नहीं आता क्या?",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 11.98,
   "end": 16.576,
   "text": "भाई, मैं ऑलरेडी बोल चुका हूँ, नेक्स्ट मंथ पे करूँगा।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 16.172,
   "end": 22.336,
   "text": "नेक्स्ट मंथ नेक्स्ट मंथ तुम पूरे फ्रॉड आदमी हो, दिमाग है भी या नहीं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 22.06,
   "end": 24.32,
   "text": "लैंग्वेज ठीक रखो।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 23.852,
   "end": 31.52,
   "text": "लैंग्वेज छोड़ो काल तक पैसा नहीं आया तो हमारे बॉयज तुम्हारे घर आएंगे फिर देखना क्या होता है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 30.86,
   "end": 33.312,
   "text": "आप धमकी दे रहे हो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 32.908,
   "end": 37.607,
   "text": "जो समझना है समझो, कल शाम तक ट्रांसफर करो",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }
 ],

 "segments": [
  {
   "start": 0.0,
   "end": 6.272,
   "text": "हेलो मैं नवधन फनैन्स से अमित बोल रहा हूँ, आपके गोल्ड लोन की किस्त के बारे में।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 6.028,
   "end": 8.928,
   "text": "इतनी रात को फोन क्यों कर रहे हो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 8.524,
   "end": 14.848,
   "text": "3 महीने से पैसा नहीं दिया है कल तक पैसे नहीं दिए तो पुलिस लेकर आपके घर आएंगे",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 14.284,
   "end": 17.28,
   "text": "आप ऐसे धमकी नहीं दे सकते।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 16.716,
   "end": 21.44,
   "text": "और आपके मोहल्ले में सबको बता देंगे कि आप कर्ज नहीं चुकाते",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 20.908,
   "end": 23.712,
   "text": "मैं अगले हफ्ते पैसे दे दूंगा",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 23.372,
   "end": 27.168,
   "text": "अगले हफ्ते नहीं, कल ही चाहिए, फोन रखो।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }

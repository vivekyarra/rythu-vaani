 "segments": [
  {
   "start": 0.012,
   "end": 7.296,
   "text": "हेलो, मैं नवधान फाइनेंस से नेहा बोल रही हूँ, क्या मेरी बात अर्जुन जी से हो रही है?",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 6.604,
   "end": 8.896,
   "text": "हाँ बोलिए",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 8.3,
   "end": 16.032,
   "text": "अर्जुन जी आपके क्रेडिट कार्ड लोन का ₹7,000 का इ एम आई ओवरड्यू है इसी के लिए कॉल किया है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 15.692,
   "end": 19.456,
   "text": "मेरी जॉब चली गई है, थोड़ा टाइम चाहिए।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 19.02,
   "end": 26.048,
   "text": "मैं समझ सकती हूँ, लेकिन अगर इस वीक पेमेंट नहीं हुआ तो आपके अगेंस्ट अरेस्ट वारंट निकल जाएगा।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 25.58,
   "end": 28.928,
   "text": "क्या इतनी सी बात पे अरेस्ट",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 28.332,
   "end": 32.478,
   "text": "हाँ, इसलिए जल्दी पेमेंट कर दीजिए, थैंक यू।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }

 "segments": [
  {
   "start": 0.012,
   "end": 4.448,
   "text": "नमस्कार मैं नवधन फनैन्स से अमित बोल रहा हूँ",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 4.448,
   "end": 6.944,
   "text": "क्या मैं विजय जी से बात कर रहा हूँ",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 6.348,
   "end": 8.768,
   "text": "हाँ बोलिए",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 8.204,
   "end": 14.848,
   "text": "विजय जी आपके होम लोन की इस महीने की इ एम आई बाकी है उसी के बारे में कॉल किया है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 14.412,
   "end": 18.624,
   "text": "आप लोग बार बार फोन करके परेशान करते हैं",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 18.252,
   "end": 27.008,
   "text": "मैं समझता हूँ परेशानी के लिए माफी चाहता हूँ लगातार देरी होने पर एग्रीमेंट के अनुसार क्रेडिट ब्यूरो को रिपोर्ट किया जाता",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 27.008,
   "end": 28.672,
   "text": "बस यही बता",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 28.524,
   "end": 31.936,
   "text": "ठीक है मैं गुरुवार तक भर दूंगा",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 31.34,
   "end": 39.296,
   "text": "बहुत धन्यवाद अगर आपको कोई शिकायत हो तो आप हमारी शिकायत हेल्पलाइन या नज़दीकी ब्रांच से संपर्क कर सकते हैं।",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 38.892,
   "end": 40.3,
   "text": "ठीक है",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  }

 "segments": [
  {
   "start": 0.0,
   "end": 6.912,
   "text": "नमस्ते क्या मैं सुनील जी से बात कर रहा हूँ मैं अमित बोल रहा हूँ नवधन फनैन्स से",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 6.412,
   "end": 11.616,
   "text": "हाँ मैं सुनील ही बोल रहा हूँ, बताइए क्या बात है",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 10.828,
   "end": 19.808,
   "text": "सुनील जी आपके ट्रैक्टर लोन की इस महीने की किस्त ₹6,200 अभी बकाया है उसी बारे में फ़ोन किया",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 20.364,
   "end": 26.528,
   "text": "हर हफ्ते आप लोग फ़ोन करते हो, फसल अभी बिकी नहीं है, मैं पैसे कहाँ से लाऊं",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 25.996,
   "end": 34.08,
   "text": "मैं आपकी परेशानी समझता हूँ बस जानकारी के लिए बताता हूँ लोन अग्रीमेंट के अनुसार देरी पर लेट पेमेंट चार्ज लगेगा",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 34.252,
   "end": 36.672,
   "text": "कितना चार्ज लगेगा",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 36.364,
   "end": 45.536,
   "text": "एग्रीमेंट में लिखी दर से लगातार देरी होने पर खाता क्रेडिट ब्यूरो को रिपोर्ट हो सकता है जिससे आगे लोन मिलने में दिक्कत होती",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 45.388,
   "end": 51.136,
   "text": "ठीक है, अगले सोमवार तक मंडी से पैसा आ जाएगा तब जमा कर दूंगा",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 50.508,
   "end": 52.416,
   "text": "धन्यवाद सुनील",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 52.416,
   "end": 59.712,
   "text": "कोई शिकायत हो तो लोन एग्रीमेंट में छपे हेल्पलाइन नंबर पर या नजदीकी शाखा के शिकायत अधिकारी से बात कर सकते हैं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 59.82,
   "end": 61.728,
   "text": "खैर नमस्ते",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  }
 ],

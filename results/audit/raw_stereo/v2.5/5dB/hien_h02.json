 "name": "hien_h02",
 "segments": [
  {
   "start": 0.012,
   "end": 3.904,
   "text": "हैलो विकास पेमेंट कब कर रहे हो",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 3.372,
   "end": 6.848,
   "text": "कौन बोल रहा है इतनी रात को कॉल",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 6.156,
   "end": 12.672,
   "text": "रिकवरी डिपार्टमेंट से तुम्हारा एलेवेन थाउज़न्ड का लोन पेंडिंग है समझ नहीं आता क्या",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 12.076,
   "end": 16.512,
   "text": "भाई, मैं ऑलरेडी बोल चुका हूँ, नेक्स्ट मंथ पे करूँगा।",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 16.204,
   "end": 22.368,
   "text": "नेक्स्ट मंथ नेक्स्ट मंथ तुम पूरे फ्रॉड आदमी हो दिमाग है भी या नहीं",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 22.092,
   "end": 24.256,
   "text": "लैंग्वेज ठीक रखो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 23.948,
   "end": 31.488,
   "text": "लैंग्वेज छोड़ो कल तक पैसा नहीं आया तो हमारे बॉयज तुम्हारे घर आएंगे फिर देखना क्या होता है",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  },
  {
   "start": 30.892,
   "end": 33.28,
   "text": "आप धमकी दे रहे हो",
   "speaker_id": "ch1",
   "language": null,
   "role": "borrower"
  },
  {
   "start": 32.972,
   "end": 37.607,
   "text": "जो समझना है समझो कॉल शाम तक ट्रांसफर करो",
   "speaker_id": "ch0",
   "language": null,
   "role": "agent"
  }

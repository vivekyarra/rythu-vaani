   "end": 24.256,
   "text": "Please, కృపయా ఉంచి continue.",
   "speaker_id": "ch0",
   "language": "te-IN",
   "role": "agent"
  },
  {
   "start": 23.82,
   "end": 26.4,
   "text": "ठीक है, मैं बता दूँगी।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {

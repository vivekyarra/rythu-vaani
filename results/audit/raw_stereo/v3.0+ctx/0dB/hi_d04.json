   "text": "मैं उनकी पत्नी बोल रही हूँ, वो अभी घर पर नहीं है।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 11.18,
   "end": 17.504,
   "text": "बता दीजिए कि उनकी bike loan की 6000 रुपये की EMI 2 महीने से बकाया है।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 16.972,

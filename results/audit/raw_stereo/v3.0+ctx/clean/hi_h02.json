 "segments": [
  {
   "start": 0.044,
   "end": 9.44,
   "text": "नमस्कार, मैं रोहित, Navdhan Finance से। राजेश जी, आपके बाइक लोन की दो किस्तें बकाया हैं। उसी के लिए phone किया है।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 9.004,
   "end": 13.888,
   "text": "भाई साहब, इतनी रात को phone? मैं अभी खाना खा रहा हूँ।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 13.292,
   "end": 19.936,
   "text": "रात हो या दिन, पैसा तो देना पड़ेगा। 3 महीने से बस बहाने चल रहे हैं।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 19.404,
   "end": 23.232,
   "text": "नौकरी छूट गई है, मुझे थोड़ा समय चाहिए।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 22.7,
   "end": 28.448,
   "text": "तुम जैसे बेशर्म लोग ही उधार लेकर भाग जाते हैं। झूठ बोलना बंद करो।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 28.14,
   "end": 30.624,
   "text": "आप ऐसे बात मत कीजिए।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 30.092,
   "end": 37.12,
   "text": "बरसों तक पैसा नहीं आया, तो थाने में तुम्हारे नाम की report लिखवा दूंगा। फिर हवालात में बैठकर सोचना।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  },
  {
   "start": 36.716,
   "end": 39.808,
   "text": "ठीक है, मैं कोशिश करता हूँ।",
   "speaker_id": "ch1",
   "language": "hi-IN",
   "role": "borrower"
  },
  {
   "start": 39.468,
   "end": 44.847,
   "text": "कोशिश नहीं, परसों तक पूरे 9000 रुपये चाहिए, phone रखो।",
   "speaker_id": "ch0",
   "language": "hi-IN",
   "role": "agent"
  }
 ],

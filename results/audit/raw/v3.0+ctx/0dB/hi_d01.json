 "segments": [
  {
   "start": 0.268,
   "end": 5.53,
   "text": "नमस्ते, मैं Navdhan Finance से अमित बोल रहा हूँ। क्या मेरी बात राकेश जी से हो रही है?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 5.53,
   "end": 8.2,
   "text": "हाँ, मैं राकेश बोल रहा हूँ।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 8.2,
   "end": 13.248,
   "text": "రాకేష్ जी, मैं आपके personal loan की EMI के बारे में call कर रहा हूँ।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 13.248,
   "end": 16.128,
   "text": "10000 రూపాయలకి check, 10 due date.",
   "speaker_id": 1,
   "language": "te-IN",
   "role": null
  },
  {
   "start": 16.128,
   "end": 21.184,
   "text": "इस month की salary late है, मैं अगले सोमवार तक भर दूँगा।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 21.184,
   "end": 25.696,
   "text": "कोई बात नहीं, मैं सोमवार की तारीख नोट कर लेता हूँ।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 25.696,
   "end": 29.472,
   "text": "देरी होने पर, loan agreement के हिसाब से late fee होगी।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 29.472,
   "end": 31.872,
   "text": "OK.",
   "speaker_id": 2,
   "language": "en-IN",
   "role": null
  },
  {
   "start": 31.872,
   "end": 37.728,
   "text": "अगर आपको कोई शिकायत है, तो आप हमारे शिकायत अधिकारी से helpline पर बात कर सकते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 37.728,
   "end": 40.224,
   "text": "number आपके loan agreement.",
   "speaker_id": 1,
   "language": "en-IN",
   "role": null
  },
  {
   "start": 40.224,
   "end": 41.94,
   "text": "ठीक है।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },

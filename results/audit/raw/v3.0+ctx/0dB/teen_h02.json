   "role": null
  },
  {
   "start": 7.03,
   "end": 10.688,
   "text": "అవును, నేను చెప్పండి.",
   "speaker_id": 2,
   "language": "te-IN",
   "role": null
  },
  {
   "start": 10.688,
   "end": 14.432,
   "text": "ఆరు వేల రూపాయలు లాస్ట్ మంత్ నుంచి పెండింగ్.",

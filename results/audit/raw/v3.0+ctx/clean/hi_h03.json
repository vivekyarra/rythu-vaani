 "segments": [
  {
   "start": 0.012,
   "end": 5.95,
   "text": "नमस्ते, क्या महेश जी घर पर हैं? मैं अमित बोल रहा हूँ Navdhan Finance से।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 5.95,
   "end": 11.04,
   "text": "मैं उनकी पत्नी बोल रही हूँ, वो खेप पर गए हैं, क्या काम है?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 11.04,
   "end": 19.27,
   "text": "के भाभी जी, आपके पति ने भैंस के लिए जो loan लिया था, उसकी दो किस्तें कुल 8400 रुपये। बकाया है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.27,
   "end": 22.656,
   "text": "मुझे तो इस बारे में कुछ पता ही नहीं था।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 22.656,
   "end": 26.39,
   "text": "अब तो पता चल गया है, उनसे कहिये गुरुवार तक जमा कर दें।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 26.39,
   "end": 30.42,
   "text": "मैं बता दूँगी, पर वह आजकल बहुत परेशान है।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 30.42,
   "end": 37.888,
   "text": "परेशान तो हम भी हैं। गुरुवार तक नहीं हुआ तो सरपंच और पड़ोसियों को बता देंगे कि महेश जी पैसा नहीं लौटा रहे।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 37.888,
   "end": 41.31,
   "text": "पूरे गाँव में बदनामी होगी।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 41.31,
   "end": 44.711,
   "text": "तो फिर पैसों का इंतज़ाम करवाइए। नमस्ते।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  }
 ],

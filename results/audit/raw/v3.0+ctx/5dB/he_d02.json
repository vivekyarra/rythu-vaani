 "segments": [
  {
   "start": 0.108,
   "end": 6.15,
   "text": "Good morning, मैं Navdhan Finance से रोहित बोल रहा हूँ। क्या मैं प्रिया जी से बात कर रहा हूँ?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.15,
   "end": 7.872,
   "text": "हाँ, बोलिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 7.872,
   "end": 15.36,
   "text": "प्रिया जी, आपके टू व्हीलर लोन की ईएमआई की due date निकल गई है, उसी के reminder के लिए call किया है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 15.36,
   "end": 19.584,
   "text": "अरे, मैं भूल गई थी, आज ही online pay कर देती हूँ।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.584,
   "end": 24.864,
   "text": "Thank you, अगर payment में कोई problem हो तो हम restructuring options भी discuss कर सकते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 24.864,
   "end": 27.072,
   "text": "ठीक है, शुक्रिया।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 27.072,
   "end": 34.24,
   "text": "और कोई complaint हो तो आप हमारे grievance officer को email कर सकते हैं। details आपके loan agreement में हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 34.24,
   "end": 36.056,
   "text": "Okay, thank you.",
   "speaker_id": 2,
   "language": "en-IN",
   "role": null
  }
 ],

 "segments": [
  {
   "start": 0.0,
   "end": 6.02,
   "text": "नमस्ते, मैं Navadand Finance से रोहित बोल रहा हूँ, क्या मनोज जी से बात हो सकती है?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.02,
   "end": 10.432,
   "text": "मैं उनकी पत्नी बोल रही हूँ, वो अभी घर पर नहीं हैं।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 10.432,
   "end": 17.04,
   "text": "अच्छा, उनको बता दीजिए कि उनकी bike loan की 6,000 रुपये की EMI दो महीने से बकाया है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 17.04,
   "end": 19.36,
   "text": "मुझे इस बारे में कुछ नहीं पता था।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.36,
   "end": 23.65,
   "text": "ठीक है, कृपया उनसे कहिये कि मुझे इसी number पर call कर लें।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 23.65,
   "end": 26.08,
   "text": "ठीक है, मैं बता दूँगी।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 26.08,
   "end": 31.516,
   "text": "किसी भी शिकायत के लिए आप हमारे grievance officer से संपर्क कर सकते हैं। धन्यवाद।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  }

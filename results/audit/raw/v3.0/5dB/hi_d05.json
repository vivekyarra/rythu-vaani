{
 "name": "hi_d05",
 "segments": [
  {
   "start": 0.012,
   "end": 4.48,
   "text": "नमस्कार, मैं Navdhanya Finance से अमित बोल रहा हूँ।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 4.48,
   "end": 6.76,
   "text": "मैं विजय जी से बात कर रहा हूँ।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.76,
   "end": 8.6,
   "text": "हाँ, बोलिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 8.6,
   "end": 14.88,
   "text": "विजय जी, आपके home loan की इस महीने की EMI बाकी है, उसी के बारे में call किया है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 14.88,
   "end": 18.624,
   "text": "आप लोग बार-बार phone करके परेशान करते हैं।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 18.624,
   "end": 27.04,
   "text": "मैं समझता हूँ, परेशानी के लिए माफी चाहता हूँ। लगातार देरी होने पर agreement के अनुसार credit bureau को report किया जाता है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 27.04,
   "end": 28.672,
   "text": "बस यही बताना है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 28.672,
   "end": 31.84,
   "text": "ठीक है, मैं गुरुवार तक घर दूँगा।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 31.84,
   "end": 39.264,
   "text": "अगर आपको कोई शिकायत हो तो आप हमारी शिकायत helpline या नजदीकी branch से संपर्क कर सकते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 39.264,
   "end": 40.3,
   "text": "ठीक है।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  }

 "segments": [
  {
   "start": 0.0,
   "end": 6.1,
   "text": "नमस्ते, मैं Navdhun Finance से रोहित बोल रहा हूँ। क्या मनोज जी से बात हो सकती है?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.1,
   "end": 10.368,
   "text": "मैं उनकी पत्नी बोल रही हूँ। वो अभी घर पर नहीं हैं।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 10.368,
   "end": 16.78,
   "text": "अच्छा, उनको बता दीजिए कि उनकी bike loan की 6,000 रुपये की EMI दो महीने से बकाया है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 16.78,
   "end": 19.88,
   "text": "मुझे इस बारे में कुछ नहीं पता sir।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.88,
   "end": 24.13,
   "text": "कृपया उनसे कहिए कि मुझे इसी number पर call करें।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 24.13,
   "end": 25.91,
   "text": "ठीक है, मैं बता दूँगी।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 25.91,
   "end": 31.516,
   "text": "किसी भी शिकायत के लिए आप हमारे grievance officer से संपर्क कर सकते हैं। धन्यवाद।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  }

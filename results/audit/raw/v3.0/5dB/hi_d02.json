{
 "name": "hi_d02",
 "segments": [
  {
   "start": 0.0,
   "end": 3.616,
   "text": "Hello, मैं Navdhanya Finance से अमित बोल रहा हूँ।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 3.616,
   "end": 6.272,
   "text": "आपके gold loan की किस्त के बारे में",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.272,
   "end": 8.896,
   "text": "आप इतनी रात को फोन क्यों कर रहे हैं?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 8.896,
   "end": 14.14,
   "text": "3 महीने से पैसा नहीं दिया है। कल तक पैसे नहीं दिए, तो पुलिस लेकर आपके घर आएंगे।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 14.14,
   "end": 17.12,
   "text": "आप ऐसे धमकी नहीं दे सकते।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 17.12,
   "end": 21.18,
   "text": "आपके मोहल्ले में सबको बता देंगे कि आप कर्ज नहीं चुकाते।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 21.18,
   "end": 23.616,
   "text": "मैं अगले हफ्ते पैसे दे दूंगा।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 23.616,
   "end": 27.072,
   "text": "अगले हफ्ते नहीं, कल ही चाहिए। फोन रखो",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  }

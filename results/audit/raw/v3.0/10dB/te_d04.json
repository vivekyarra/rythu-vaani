   "role": null
  },
  {
   "start": 12.032,
   "end": 15.38,
   "text": "కలెక్షన్ టీమ్ నుండి ఈ శుక్రవారం లోపు కట్టండి.",
   "speaker_id": 1,
   "language": "te-IN",
   "role": null
  },
  {
   "start": 15.38,
   "end": 17.38,
   "text": "సరే, కడతాను.",
   "speaker_id": 2,
   "language": "te-IN",
   "role": null
  },
  {

  {
   "start": 0.044,
   "end": 9.376,
   "text": "नमस्कार, मैं रोहित नवधन फाइनेंस से। राजेश जी, आपके bike loan की दो किश्तें बकाया हैं? उसी के लिए phone किया है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 9.376,
   "end": 11.92,
   "text": "भाई साहब, इतनी रात को phone?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 11.92,
   "end": 13.57,
   "text": "मैं अभी खाना खा रहा हूँ।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 13.57,
   "end": 19.27,
   "text": "रात हो या दिन, पैसा तो देना पड़ेगा। 3 महीने से बस बहाने चल रहे हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.27,
   "end": 23.14,
   "text": "नौकरी छूट गई है, मुझे थोड़ा समय चाहिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 23.14,
   "end": 28.448,
   "text": "जैसे बेशर्म लोग ही उधार लेकर भाग जाते हैं, झूठ बोलना बंद करो।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 28.448,
   "end": 30.24,
   "text": "आप ऐसे बात मत कीजिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 30.24,
   "end": 37.152,
   "text": "बरसों तक पैसा नहीं आया, तो थाने में तुम्हारे नाम की report लिखवा दूंगा। फिर हवालात में बैठकर सोचना।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 37.152,
   "end": 39.776,
   "text": "ठीक है, मैं कोशिश करता हूँ।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 39.776,
   "end": 44.847,
   "text": "कोशिश नहीं, परसों तक पूरे 9000 रुपये चाहिए। phone रखो।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  }

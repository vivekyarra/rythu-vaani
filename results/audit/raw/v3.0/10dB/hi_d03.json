  {
   "start": 0.012,
   "end": 3.91,
   "text": "हाँ सुनीता जी, आपकी EMI अभी तक क्यों नहीं आई?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 3.91,
   "end": 7.104,
   "text": "जी, आप कौन बोल रहे हैं?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 7.104,
   "end": 10.59,
   "text": "वो छोड़िए, पहले बताइए पैसे कब देंगे?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 10.59,
   "end": 13.792,
   "text": "पहले बताइए आप कहाँ से बोल रहे हैं?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 13.792,
   "end": 17.69,
   "text": "आप जैसे बेशर्म लोग loan लेते हैं और फिर भाग जाते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 17.69,
   "end": 20.096,
   "text": "आप समीर से बात कीजिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 20.096,
   "end": 27.456,
   "text": "शुक्रवार तक 4,000 रुपये जमा कर दीजिए। कोई शिकायत है तो आप हमारी helpline पर call कर सकते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 27.456,
   "end": 28.554,
   "text": "ठीक है।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  }

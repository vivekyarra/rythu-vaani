 "segments": [
  {
   "start": 0.0,
   "end": 7.64,
   "text": "नमस्ते, मैं अमित बोल रहा हूँ। क्या गीता देवी जी से बात हो रही है? आपकी किस्त के सिलसिले में फोन किया है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 7.64,
   "end": 11.87,
   "text": "हाँ, मैं गीता बोल रही हूँ। आप किस company से हैं?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 11.87,
   "end": 18.688,
   "text": "जी, वो छोड़िए, बस इतना बताइए कि 5,000 रुपये की बकाया किस्त कब तक जमा करेंगे।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 18.688,
   "end": 22.7,
   "text": "इस महीने बेटी की school fees भरनी थी, अगले महीने दे दूँगी।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 22.7,
   "end": 30.88,
   "text": "समझ सकता हूँ जी, पर मैं नहीं चाहता कि हमारी field team आपके घर आकर सामान जब्त करे, आप भी नहीं चाहेंगे ना?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 30.88,
   "end": 33.024,
   "text": "आप मुझे डरा रहे हैं क्या?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 33.024,
   "end": 37.856,
   "text": "माफ कीजिए, अगर ऐसा लगा, आप अगले बुधवार तक जमा कर दीजिए।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 37.856,
   "end": 40.04,
   "text": "ठीक है, कोशिश करूंगी।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 40.04,
   "end": 46.196,
   "text": "धन्यवाद, कोई शिकायत हो तो आप नज़दीकी शाखा में शिकायत अधिकारी से मिल सकती हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  }

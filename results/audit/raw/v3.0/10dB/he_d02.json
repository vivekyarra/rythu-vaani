 "segments": [
  {
   "start": 0.108,
   "end": 6.09,
   "text": "Good morning, मैं Navdhanya Finance से रोहित बोल रहा हूँ, क्या मैं प्रिया जी से बात कर रहा हूँ?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.09,
   "end": 7.904,
   "text": "हाँ बोलिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 7.904,
   "end": 15.328,
   "text": "भैया जी, आपके two wheeler loan की EMI की due date निकल गई है, उसी के reminder के लिए call किया है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 15.328,
   "end": 19.616,
   "text": "अरे, मैं भूल गई थी, आज ही online pay कर देती।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.616,
   "end": 24.82,
   "text": "Thank you। अगर payment में कोई problem हो तो हम restructuring options भी discuss कर सकते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 24.82,
   "end": 27.072,
   "text": "ठीक है, शुक्रिया।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 27.072,
   "end": 34.304,
   "text": "और कोई complaint हो तो आप हमारे grievance officer को email कर सकते हैं। details आपके loan agreement में हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 34.304,
   "end": 36.056,
   "text": "Okay, thank you.",
   "speaker_id": 2,
   "language": "en-IN",
   "role": null
  }

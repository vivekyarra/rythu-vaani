 "segments": [
  {
   "start": 0.012,
   "end": 6.048,
   "text": "नमस्ते, क्या महेश जी की खबर है? मैं अमित बोल रहा हूँ, मतलब।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.048,
   "end": 10.944,
   "text": "मैं उनकी पत्नी बोल रही हूँ। वो खेत पर गए हैं। क्या कहा?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 10.944,
   "end": 19.936,
   "text": "देखिए sir, आपके पति ने भैंस के लिए जो loan लिया था, उसकी दो किश्तें हैं। कुल 8,400 रुपये। बकाया।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.936,
   "end": 22.496,
   "text": "पर हमें कुछ पता ही नहीं है।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 22.496,
   "end": 26.69,
   "text": "तो पता चल गया। उनसे कहिए गुरुवार तक जमा करा।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 26.69,
   "end": 30.368,
   "text": "मैं बता दूँगी, पर वो आजकल बहुत परेशान है।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 30.368,
   "end": 37.46,
   "text": "परेशान तो हम भी हैं। गुरुवार तक नहीं हुआ तो सरपंच और पड़ोसियों को बता देंगे कि महेश जी पैसा नहीं लौटा रहे।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 37.46,
   "end": 39.36,
   "text": "समझिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 39.36,
   "end": 41.344,
   "text": "गाँव में बदनामी।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 41.344,
   "end": 44.711,
   "text": "सिर्फ पैसों का इंतजाम करना है। नमस्कार।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  }

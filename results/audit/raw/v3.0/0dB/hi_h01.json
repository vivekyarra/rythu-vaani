 "segments": [
  {
   "start": 0.044,
   "end": 6.752,
   "text": "नमस्ते, क्या मैं सुनील जी से बात कर रहा हूँ? मैं अमित बोल रहा हूँ, नवधन Finance से।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.752,
   "end": 11.24,
   "text": "हाँ, मैं सुनील ही बोल रहा हूँ। बताइए, क्या बात है?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 11.24,
   "end": 19.712,
   "text": "सुनील, आपके tractor loan की किश्त होने की किश्त 6,200 रुपये अभी बकाया है। उसी बारे में phone किया था।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.948,
   "end": 23.008,
   "text": "से आप लोग फोन करते हो।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 23.008,
   "end": 25.91,
   "text": "नहीं है, मैं पैसे कहाँ से लाऊँ?",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 25.91,
   "end": 30.464,
   "text": "मैं आपकी परेशानी समझता हूँ, बस जानकारी के लिए बता रहा हूँ।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 30.464,
   "end": 34.112,
   "text": "loan agreement के अनुसार देरी पर late payment charge होगा।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 34.252,
   "end": 36.608,
   "text": "हाँ, 400 रुपये।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 36.608,
   "end": 42.88,
   "text": "agreement में लिखी दर से लगातार देरी होने पर खाता credit bureau को report देता है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 42.88,
   "end": 45.408,
   "text": "आगे लोन मिलने में दिक्कत",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 45.408,
   "end": 50.45,
   "text": "ठीक है, अगले सोमवार तक मंडी से पैसा आ जाएगा, तब जमा कर दूँगा।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 50.45,
   "end": 52.416,
   "text": "धन्यवाद sir।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 52.416,
   "end": 59.424,
   "text": "गायब हो तो loan agreement में दिए helpline number पर या नजदीकी शाखा के शिकायत अधिकारी से बात कर सकते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 59.424,
   "end": 61.728,
   "text": "नमस्ते।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  }

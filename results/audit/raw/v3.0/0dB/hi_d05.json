 "segments": [
  {
   "start": 1.228,
   "end": 4.48,
   "text": "मैं Navdharm Finance से अमित बोल रहा हूँ।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 4.48,
   "end": 6.71,
   "text": "से बात करना है।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 6.71,
   "end": 8.5,
   "text": "बोलिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 8.5,
   "end": 14.816,
   "text": "विजय जी, आपके home loan की इस महीने की EMI बाकी है। उसी के बारे में call किया था।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 14.816,
   "end": 18.528,
   "text": "लोग बार बार phone करके परेशान करते हैं।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 18.528,
   "end": 26.976,
   "text": "मैं समझता हूँ, परेशानी के लिए माफी चाहता हूँ। लगातार देरी होने पर agreement के अनुसार credit bureau को report किया जाएगा।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 26.976,
   "end": 28.544,
   "text": "बस यही बात।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 28.544,
   "end": 31.808,
   "text": "ठीक है, मैं गुरुवार तक घर बैठूँगी।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 31.808,
   "end": 38.976,
   "text": "अगर आपको कोई शिकायत हो तो आप हमारी शिकायत helpline या नजदीकी branch से संपर्क कर सकते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 38.976,
   "end": 40.3,
   "text": "ठीक है।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  }

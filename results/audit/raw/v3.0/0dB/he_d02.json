 "segments": [
  {
   "start": 0.108,
   "end": 5.81,
   "text": "Good morning, मैं Navadhan Finance से रोहित बोल रहा हूँ। क्या मैं प्रिया जी से बात कर रहा हूँ?",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 5.81,
   "end": 7.904,
   "text": "हाँ, बोलिए।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 7.904,
   "end": 15.328,
   "text": "जी आपके two wheeler loan की EMI की due date निकल गई। किसी के reminder के लिए call किया था।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 15.328,
   "end": 19.52,
   "text": "भूल गई थी, आज ही online pay कर देते हैं।",
   "speaker_id": 2,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 19.52,
   "end": 24.896,
   "text": "अगर payment में कोई problem है तो हम restructuring option भी discuss कर सकते हैं।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 24.896,
   "end": 27.04,
   "text": "शुक्रिया।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 27.04,
   "end": 33.92,
   "text": "और कोई complaint हो तो आप हमारे grievance officer को email कर सकते हैं। details आपके loan apply में।",
   "speaker_id": 1,
   "language": "hi-IN",
   "role": null
  },
  {
   "start": 33.996,
   "end": 36.056,
   "text": "Okay, thank you.",

   "language": null,
   "role": null
  },
  {
   "start": 13.792,
   "end": 17.69,
   "text": "आप जैसे बेशर्म लोग लोन लेते हैं और फिर भाग जाते हैं",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 17.69,
   "end": 20.096,
   "text": "आप तमीज़ से बात कीजिए",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 20.096,
   "end": 27.456,
   "text": "शुक्रवार तक ₹4,000 जमा कर दीजिए कोई शिकायत है तो आप हमारी हेल्पलैन पर कॉल कर सकते हैं",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {

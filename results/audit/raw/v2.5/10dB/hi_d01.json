 "segments": [
  {
   "start": 0.0,
   "end": 5.59,
   "text": "नमस्ते मैं नवधन फनैन्स से अमित बोल रहा हूँ क्या मेरी बात राकेश जी से हो रही है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 5.59,
   "end": 8.11,
   "text": "हाँ मैं राकेश बोल रहा हूँ",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 8.11,
   "end": 16.16,
   "text": "राकेश जी मैं आपके पर्सनल लोन की इ एम आई के बारे में कॉल कर रहा हूँ ₹5,000 की किस्त 10 दिन से बाकी है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 16.16,
   "end": 21.0,
   "text": "हाँ इस महीने तनख्वाह देर से आएगी मैं अगले सोमवार तक भर दूंगा",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 21.0,
   "end": 29.664,
   "text": "ठीक है कोई बात नहीं मैं सोमवार की तारीख नोट कर लेता हूँ देरी होने पर लोन अग्रीमेंट के हिसाब से लेट फीस लगेगी",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 29.664,
   "end": 31.75,
   "text": "ठीक है समझ गया",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 31.75,
   "end": 40.416,
   "text": "अगर आपको कोई शिकायत हो तो आप हमारे शिकायत अधिकारी से हेल्पलैन पर बात कर सकते हैं नंबर आपके लोन अग्रीमेंट में दिया है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 40.416,
   "end": 41.71,
   "text": "ठीक है धन्यवाद",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 41.71,
   "end": 45.216,
   "text": "धन्यवाद राकेश जी, आपका दिन शुभ",
   "speaker_id": 1,
   "language": null,
   "role": null
  }

 "name": "hi_h02",
 "segments": [
  {
   "start": 0.044,
   "end": 9.376,
   "text": "नमस्कार मैं रोहित नवधन फनैन्स से राजेश जी आपके बाइक लोन की 2 किस्में बकाया है उसी के लिए फ़ोन किया है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 9.376,
   "end": 11.92,
   "text": "भाई साहब इतनी रात को फ़ोन",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 11.92,
   "end": 13.57,
   "text": "मैं अभी खाना खा रहा",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 13.57,
   "end": 19.27,
   "text": "रात हो या दिन पैसा तो देना पड़ेगा 3 महीने से बस बहाने चल रहे हैं",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 19.27,
   "end": 23.14,
   "text": "नौकरी छूट गई है, मुझे थोड़ा समय चाहिए।",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 23.14,
   "end": 28.448,
   "text": "तुम जैसे बेशर्म लोग ही उधार लेकर भाग जाते हैं झूठ बोलना बंद करो",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 28.448,
   "end": 30.24,
   "text": "आप ऐसे बात मत कीजिए",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 30.24,
   "end": 37.152,
   "text": "परसों तक पैसा नहीं आया तो थाने में तुम्हारे नाम की रिपोर्ट लिखवा दूंगा फिर हवालात में बैठकर सोचना",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 37.152,
   "end": 39.776,
   "text": "ठीक है, मैं कोशीश करता हूँ",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 39.776,
   "end": 44.847,
   "text": "कोशीश नहीं परसों तक पूरे ₹9,000 चाहिए फ़ोन रखो",
   "speaker_id": 1,
   "language": null,
   "role": null
  }

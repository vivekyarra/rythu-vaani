 "segments": [
  {
   "start": 0.108,
   "end": 6.09,
   "text": "गुड मॉर्निंग मैं नवधान फनैन्स से रोहित बोल रहा हूँ क्या मैं प्रिया जी से बात कर रहा हूँ",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 6.09,
   "end": 7.904,
   "text": "हाँ बोलिए",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 7.904,
   "end": 15.328,
   "text": "प्रिया जी आपके टू व्हीलर लोन की इ एम आई की दुए डेट निकल गई है उसी के रिमाइंडर के लिए कॉल किया है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 15.328,
   "end": 19.616,
   "text": "अरे मैं भूल गई थी आज ही ऑनलाइन पे कर देती",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 19.616,
   "end": 24.82,
   "text": "थैंक यू अगर पेमेंट में कोई प्रॉब्लम हो तो हम रीस्ट्रक्चरिंग ऑप्शन्ज़ भी डिस्कॅस कर सकते है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 24.82,
   "end": 27.072,
   "text": "ठीक है शुक्रिया",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 27.072,
   "end": 34.304,
   "text": "और कोई कंप्लेंट हो तो आप हमारे ग्रीवेंस ऑफिसर को ईमेल कर सकते हैं डीटेल्स आपके लोन अग्रीमेंट में है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 34.304,
   "end": 36.056,
   "text": "ओके थैंक यू",
   "speaker_id": 2,
   "language": null,
   "role": null
  }

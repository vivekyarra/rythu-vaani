 "segments": [
  {
   "start": 0.012,
   "end": 4.46,
   "text": "హలో రమేష్ గారా మీ ఈఎంఐ ఎందుకు పే చేయలేదు",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 4.46,
   "end": 6.528,
   "text": "ఎవరు మాట్లాడుతున్నారు",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 6.528,
   "end": 10.912,
   "text": "అది ఇంపార్టంట్ కాదు మీ పేమెంట్ మూడు వీక్స్ నుండి ఓవర్ యూ",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 10.912,
   "end": 13.97,
   "text": "సాలరీ లేట్ అయింది సర్ నెక్స్ట్ వీక్ పే చేస్తాను",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 13.97,
   "end": 18.496,
   "text": "మీలాంటి ఫీటర్స్ వల్లే కంపెనీకి లాస్ యూస్లెస్ ఫెలో",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 18.496,
   "end": 20.768,
   "text": "ప్లీజ్ రెస్పెక్ట్ గా మాట్లాడండి",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 20.768,
   "end": 26.304,
   "text": "మండే లోపల పే చేయండి ఏదైనా కంప్లైంట్ ఉంటే మా కస్టమర్ కేర్ కి కాల్ చేయండి",
   "speaker_id": 1,
   "language": null,
   "role": null
  }

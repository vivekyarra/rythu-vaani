   "language": null,
   "role": null
  },
  {
   "start": 13.41,
   "end": 14.88,
   "text": "ఇది నాకు తెలియదు",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 14.88,
   "end": 19.06,
   "text": "కట్టకపోతే మీ ఊరి వాట్సాప్ గ్రూప్ లో అందరికీ చెప్తా",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {

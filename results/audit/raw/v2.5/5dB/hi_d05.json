{
 "name": "hi_d05",
 "segments": [
  {
   "start": 0.012,
   "end": 4.48,
   "text": "नमस्कार मैं नवधन फनैन्स से अमित बोल रहा हूँ",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 4.48,
   "end": 6.76,
   "text": "क्या मैं विजय जी से बात कर रहा हूँ",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 6.76,
   "end": 8.6,
   "text": "हाँ बोलिए",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 8.6,
   "end": 14.88,
   "text": "विजय जी आपके होम लोन की इस महीने की इ एम आई बाकी है उसी के बारे में कॉल किया है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 14.88,
   "end": 18.624,
   "text": "आप लोग बार बार फोन करके परेशान करते हैं",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 18.624,
   "end": 27.04,
   "text": "मैं समझता हूँ परेशानी के लिए माफी चाहता हूँ लगातार देरी होने पर एग्रीमेंट के अनुसार क्रेडिट ब्यूरो को रिपोर्ट किया जाता",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 27.04,
   "end": 28.672,
   "text": "बस यही बताना",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 28.672,
   "end": 31.84,
   "text": "ठीक है, मैं गुरुवार तक भर दूंगा",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 31.84,
   "end": 39.264,
   "text": "बहुत धन्यवाद अगर आपको कोई शिकायत हो तो आप हमारी शिकायत हेल्पलाइन या नज़दीकी ब्रांच से संपर्क कर सकते हैं",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 39.264,
   "end": 40.3,
   "text": "ठीक है",
   "speaker_id": 2,
   "language": null,
   "role": null
  }
 ],

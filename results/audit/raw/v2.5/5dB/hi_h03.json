 "name": "hi_h03",
 "segments": [
  {
   "start": 0.0,
   "end": 6.272,
   "text": "नमस्ते क्या महेश जी घर पर हैं मैं अमित बोल रहा हूँ",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 6.272,
   "end": 10.976,
   "text": "मैं उनकी पत्नी बोल रही हूँ, वो खेत पर गए हैं, क्या काम है?",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 10.976,
   "end": 19.72,
   "text": "देखिए भाभी जी आपके पति ने भैंस के लिए जो लोन लिया था उसकी 2 किस्तें कुल ₹8,400 बकाया है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 19.72,
   "end": 22.496,
   "text": "मुझे तो इस बारे में कुछ पता ही नहीं था",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 22.496,
   "end": 26.84,
   "text": "अब तो पता चल गया है उनसे कहिए गुरुवार तक जमा कर",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 26.84,
   "end": 30.31,
   "text": "मैं बता दूंगी पर वो आजकल बहुत परेशान हैं",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 30.31,
   "end": 37.54,
   "text": "परेशान तो हम भी हैं गुरुवार तक नहीं हुआ तो सरपंच और पड़ोसियों को बता देंगे कि महेश जी पैसा नहीं लौटा रहे",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 37.54,
   "end": 40.91,
   "text": "ऐसा मत कीजिए पूरे गांव में बदनामी होगी",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 40.91,
   "end": 44.711,
   "text": "तो फिर पैसों का इंतजाम करवा नमस्ते",
   "speaker_id": 1,
   "language": null,
   "role": null
  }

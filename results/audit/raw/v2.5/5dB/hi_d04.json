 "segments": [
  {
   "start": 0.0,
   "end": 6.1,
   "text": "नमस्ते मैं नवजन फनैन्स से रोहित बोल रहा हूँ क्या मनोज जी से बात हो सकती है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 6.1,
   "end": 10.368,
   "text": "मैं उनकी पत्नी बोल रही हूं वो अभी घर पर नहीं है",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 10.368,
   "end": 16.78,
   "text": "अच्छा उनको बता दीजिए कि उनकी बाइक लोन की ₹6,000 की इ एम आई 2 महीने से बकाया है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 16.78,
   "end": 19.88,
   "text": "मुझे इस बारे में कुछ नहीं पता था",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 19.88,
   "end": 24.13,
   "text": "ठीक है, कृपया उनसे कहिए कि मुझे इसी नंबर पर कॉल करें।",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 24.13,
   "end": 25.91,
   "text": "ठीक है मैं बता दूंगी",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 25.91,
   "end": 31.516,
   "text": "किसी भी शिकायत के लिए आप हमारे ग्रीवेंस ऑफिसर से संपर्क कर सकते हैं, धन्यवाद",
   "speaker_id": 1,
   "language": null,
   "role": null
  }

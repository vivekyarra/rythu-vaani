 "segments": [
  {
   "start": 1.228,
   "end": 4.48,
   "text": "मैं नवधम फनैन्स से अमित बोल",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 4.48,
   "end": 6.71,
   "text": "क्या मैं विजय जी से बात कर रहा हूँ",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 6.71,
   "end": 8.5,
   "text": "हाँ बोलिए",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 8.5,
   "end": 14.816,
   "text": "विजय जी आपके होम लोन की इस महीने की इ एम आई बाकी है उसी के बारे में कॉल किया",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 14.816,
   "end": 18.528,
   "text": "आप लोग बार बार फोन करके परेशान करते हैं",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 18.528,
   "end": 26.976,
   "text": "मैं समझता हूँ परेशानी के लिए माफ़ी चाहता हूँ लगातार देरी होने पर एग्रीमेंट के अनुसार क्रेडिट ब्यूरो को रिपोर्ट किया जाए",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 28.544,
   "end": 31.808,
   "text": "ठीक है मैं गुरुवार तक भर दूंगी",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 31.808,
   "end": 38.976,
   "text": "बहुत धन्यवाद अगर आपको कोई शिकायत हो तो आप हमारी शिकायत हेल्पलाइन या नज़दीकी ब्रांच से संपर्क कर सकते",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 38.976,
   "end": 40.3,
   "text": "ठीक है",
   "speaker_id": 2,
   "language": null,
   "role": null
  }

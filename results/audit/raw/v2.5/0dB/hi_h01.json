{
 "name": "hi_h01",
 "segments": [
  {
   "start": 0.044,
   "end": 6.752,
   "text": "नमस्ते क्या मैं सुनील जी से बात कर रहा हूँ मैं अमित बोल रहा हूँ नवधम फनैन्स",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 6.752,
   "end": 11.24,
   "text": "हाँ मैं सुनील ही बोल रहा हूँ बताइए क्या बात है",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 11.24,
   "end": 19.712,
   "text": "सुनील आपके ट्रैक्टर लोन की किस्त होने की किस्त ₹6,200 अभी बकाया है उसी बारे में फ़ोन किया",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 19.948,
   "end": 23.008,
   "text": "हर हफ्ते आप लोग फोन करते हो",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 23.008,
   "end": 25.91,
   "text": "बिकी नहीं है मैं पैसे कहाँ से लाऊं",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 25.91,
   "end": 30.464,
   "text": "मैं आपकी परेशानी समझता हूँ, बस जानकारी के लिए बता रहा हूँ।",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 30.464,
   "end": 34.112,
   "text": "लोन एग्रीमेंट के अनुसार देरी पर लेट पेमेंट चार्ज",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 34.252,
   "end": 36.608,
   "text": "कितना चार्ज लगेगा",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 36.608,
   "end": 42.88,
   "text": "एग्रीमेंट में लिखी दर से लगातार देरी होने पर खाता क्रेडिट ब्यूरो को रिपोर्ट दे सकता है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 42.88,
   "end": 45.408,
   "text": "जिससे आगे लोन मिलने में दिक्कत",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 45.408,
   "end": 50.45,
   "text": "ठीक है, अगले सोमवार तक मंडी से पैसा आ जाएगा, कब जमा कर दीजिए?",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 50.45,
   "end": 52.416,
   "text": "धन्यवाद",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 52.416,
   "end": 59.424,
   "text": "कोई शिकायत हो तो लोन एग्रीमेंट में छपे हेल्पलाइन नंबर पर या नजदीकी शाखा के शिकायत अधिकारी से बात कर सकते हैं",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 59.424,
   "end": 61.728,
   "text": "ठीक है नमस्ते",
   "speaker_id": 2,
   "language": null,
   "role": null
  }
 ],

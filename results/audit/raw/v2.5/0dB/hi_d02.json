 "segments": [
  {
   "start": 0.012,
   "end": 3.616,
   "text": "हैलो मैं नवधन फनैन्स से अमित बोल रहा हूँ",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 3.616,
   "end": 6.112,
   "text": "आपके गोल्ड लोन की किस्त कब है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 6.112,
   "end": 8.864,
   "text": "इतनी रात को फ़ोन क्यों कर रहे",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 8.864,
   "end": 14.17,
   "text": "3 महीने से पैसा नहीं दिया है कल तक पैसे नहीं दिए तो पुलिस लेकर आपके घर आएंगे",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 14.17,
   "end": 16.928,
   "text": "आप ऐसी धमकी नहीं दे सकते",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 16.928,
   "end": 21.06,
   "text": "और आपके मोहल्ले में सबको बता देंगे कि आप कर्ज नहीं चुकाते",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 21.06,
   "end": 23.584,
   "text": "मैं अगले हफ्ते पैसे दे दूं",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 23.584,
   "end": 27.072,
   "text": "अगले हफ्ते नहीं कभी चाहिए फ़ोन रखो",
   "speaker_id": 1,
   "language": null,
   "role": null
  }

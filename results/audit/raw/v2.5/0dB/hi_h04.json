 "segments": [
  {
   "start": 0.044,
   "end": 2.976,
   "text": "नमस्ते मैं अमित बोल रहा हूँ",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 2.976,
   "end": 7.41,
   "text": "क्या गीता देवी जी से बात हो रही है आपकी किस्त के सिलसिले में फ़ोन किया",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 7.41,
   "end": 11.84,
   "text": "हाँ मैं गीता बोल रही हूँ आप किस कंपनी से हैं",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 11.84,
   "end": 18.752,
   "text": "जी वो छोड़िए, बस इतना बताइए कि ₹5,000 की बकाया किश्त कब तक जमा करनी है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 18.752,
   "end": 22.976,
   "text": "इस महीने बेटी की स्कूल फीस भरनी अगले महीने बेगी",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 22.976,
   "end": 30.72,
   "text": "समझ सकता हूँ पर मैं नहीं चाहता कि हमारी 3 टीम आपके घर आकर सामान जब्त करे आप भी नहीं कहेंगे",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 30.72,
   "end": 32.671,
   "text": "आप मुझे डरा रहे हैं क्या",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 32.78,
   "end": 37.888,
   "text": "माफ कीजिए अगर ऐसा लगा आप अगले बुधवार तक जमा कर दीजिए",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 37.888,
   "end": 40.448,
   "text": "ठीक है कोशीश करूँगी",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 40.448,
   "end": 46.176,
   "text": "धन्यवाद, कोई शिकायत हो तो आप नज़दीकी शाखा में शिकायत अधिकारी से मिल सकती हैं",
   "speaker_id": 1,
   "language": null,
   "role": null
  }

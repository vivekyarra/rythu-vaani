 "segments": [
  {
   "start": 0.012,
   "end": 6.58,
   "text": "हैलो मैं नवधान फनैन्स से नेहा बोल रही हूँ क्या मेरी बात अर्जुन जी से हो रही है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 6.58,
   "end": 8.74,
   "text": "हाँ बोल",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 8.74,
   "end": 16.0,
   "text": "अर्जुन जी आपके क्रेडिट कार्ड लोन का ₹7,000 का इ एम आई ओवर दुए है इसी के लिए कॉल किया है",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 16.0,
   "end": 19.136,
   "text": "मेरी जॉब चली गई थोड़ा टाइम लगेगा",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 19.136,
   "end": 26.08,
   "text": "मैं समझ सकती हूँ लेकिन अगर इस बीच पेमेंट नहीं हुआ तो आपके अगेंस्ट अरेस्ट वारंट निकल जाएगा",
   "speaker_id": 1,
   "language": null,
   "role": null
  },
  {
   "start": 26.08,
   "end": 26.9,
   "text": "क्या",
   "speaker_id": 2,
   "language": null,
   "role": null
  },
  {
   "start": 26.9,
   "end": 32.478,
   "text": "हाँ इसलिए जल्दी पेमेंट कर दीजिए थैंक यू",
   "speaker_id": 1,
   "language": null,
   "role": null
  }

# Copy to .env and paste your own key from https://app.gnani.ai/voice
# .env is gitignored. Never commit a real key.
# Leave empty to run in MOCK mode (offline: no network calls, test outputs).
GNANI_API_KEY=

# Live mandi prices from Agmarknet (optional). Free key: log in at https://www.data.gov.in,
# then open your dashboard / My Account and copy the API key. Without it, sample prices are used.
DATA_GOV_IN_API_KEY=

# WhatsApp channel (optional). See WHATSAPP.md. All four are needed to turn it on.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# GRAPH_API_VERSION=v21.0
